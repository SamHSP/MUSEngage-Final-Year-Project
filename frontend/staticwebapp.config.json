{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/service-worker.js",
      "/manifest.webmanifest",
      "/static/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg"
    ]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html"
    }
  }
}

